{
  "mcpServers": {
    "usage_coach": {
      "command": "node",
      "args": [
        "./server/mcp-server.mjs"
      ],
      "cwd": ".",
      "enabled": true,
      "env_vars": [
        "CODEX_MCP_NODE_PATH",
        "CODEX_BROWSER_USE_NODE_PATH",
        "CODEX_ELECTRON_RESOURCES_PATH",
        "CODEX_CLI_PATH",
        "CODEX_HOME",
        "USERPROFILE",
        "LOCALAPPDATA",
        "APPDATA",
        "PATH",
        "HOME",
        "USAGE_COACH_AUTO_PET",
        "USAGE_COACH_SESSIONS"
      ],
      "startup_timeout_sec": 90,
      "tool_timeout_sec": 120,
      "omit_tools_from": [
        "deferred"
      ]
    }
  }
}
